  doi         = {10.21203/rs.3.rs-7622287/v1},
  html        = {https://www.researchsquare.com/article/rs-7622287/v1},
  code        = {https://github.com/george-sideris/LARK},
  abstract    = {LARK is an open-source, multi-camera optical tracking system for image-guided surgery. A ring-shaped fixture of RGB cameras mounted on the surgical light tracks instruments and a static patient reference with sub-millimeter accuracy (median target registration error of 0.64 mm static and 0.73 mm dynamic), degrades gracefully under partial occlusion, and costs roughly an order of magnitude less than commercial systems.},
